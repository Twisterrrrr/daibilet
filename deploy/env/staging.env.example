# Staging /opt/daibilet-staging — copy to .env and fill secrets.
NODE_ENV=production
PORT=4001

DATABASE_URL=postgresql://daibilet:change-me@127.0.0.1:5437/daibilet

DAIBILET_REQUIRE_ADMIN_AUTH=1
ADMIN_EMAIL=admin@daibilet.ru
ADMIN_PASSWORD=
ADMIN_AUTH_REALM="Daibilet admin"

TICKETSCLOUD_API_TOKEN=
TICKETSCLOUD_WIDGET_TOKEN=
TEP_API_URL=https://api.teplohod.info/v1
TEP_WIDGET_ID=14208

# Build-time (deploy-staging.sh)
# PUBLIC_API_URL=https://staging.daibilet.ru
# PUBLIC_SITE_URL=https://staging.daibilet.ru
# BUILD_NODE_ENV=development

# Optional: typed stack on staging (switch systemd to start:ts — see daibilet-api-staging-ts.service.example)
# DAIBILET_TS_PUBLIC_CATALOG=1
# DAIBILET_TS_PUBLIC_EVENT=1
# DAIBILET_TS_PUBLIC_CITY=1
# DAIBILET_TS_PUBLIC_VENUE=1
# DAIBILET_PUBLIC_PREWARM_BEFORE_LISTEN=1

# Post-deploy (post-deploy-check.sh)
# POST_DEPLOY_PUBLIC_BASE=https://staging.daibilet.ru
# POST_DEPLOY_INVARIANTS=1
