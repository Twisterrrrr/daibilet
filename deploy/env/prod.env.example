# Prod rollout — Phase E flags (enable one at a time after staging parity green).
# Requires: npm --prefix apps/backend run start:ts (see deploy/systemd/daibilet-api.service)
# Rollback: comment flags + systemctl restart daibilet-api (legacy dto.js path when flags off)

# Step 4 — all public flags on
DAIBILET_TS_PUBLIC_CATALOG=1
DAIBILET_TS_PUBLIC_EVENT=1
DAIBILET_TS_PUBLIC_CITY=1
DAIBILET_TS_PUBLIC_VENUE=1
# DAIBILET_PUBLIC_PREWARM_BEFORE_LISTEN=1

# E4 — admin read
DAIBILET_TS_ADMIN_EVENTS=1
DAIBILET_TS_ADMIN_ORDERS=1

# Buyer auth (/api/user/auth/*, /login, /account/purchases) — обязателен на prod
# openssl rand -hex 32
USER_JWT_SECRET=
USER_JWT_ACCESS_TTL_SEC=900
USER_JWT_REFRESH_TTL_SEC=2592000
PUBLIC_CORS_ORIGINS=https://daibilet.ru,https://www.daibilet.ru,https://admin.daibilet.ru

# Next ISR: invalidate home after tc:sync / admin sync (Bearer to POST /api/internal/revalidate)
# openssl rand -hex 32
DAIBILET_NEXT_REVALIDATE_SECRET=
DAIBILET_WEB_REVALIDATE_URL=http://127.0.0.1:3001
# Teplohod catalog sync - prefer out-of-process cron/systemd on 3.8Gi:
#   deploy/cron/tep-catalog-sync.sh + daibilet-tep-catalog-sync.timer
# In-process (server.js) kept as fallback; disable when cron/timer is active.
TEP_AUTO_SYNC_ENABLED=0
TEP_AUTO_SYNC_INTERVAL_MS=43200000
TEP_AUTO_SYNC_WARM_DELAY_MS=900000
TEP_AUTO_SYNC_STARTUP_DELAY_MS=2700000
TEP_AUTO_SYNC_SKIP_IF_FRESH_MS=21600000
TEP_SYNC_NICE=15
# Full public cache warm on API listen: off (post-sync delayed warm only)
DAIBILET_PUBLIC_STARTUP_WARM=0
