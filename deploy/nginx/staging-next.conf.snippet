# F3 staging: Next.js public on :3000, legacy API on :4001
# Replace static SPA root block in staging.daibilet.ru.conf
# Upstreams:
#   daibilet_web_staging  → 127.0.0.1:3000  (apps/web)
#   daibilet_api_staging  → 127.0.0.1:4001  (sync/admin/writes)

upstream daibilet_web_staging {
    server 127.0.0.1:3000;
    keepalive 8;
}

upstream daibilet_api_staging {
    server 127.0.0.1:4001;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name staging.daibilet.ru;

    ssl_certificate     /etc/letsencrypt/live/staging.daibilet.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.daibilet.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Robots-Tag "noindex, nofollow" always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml text/html;

    # Legacy API: sync, admin proxy, writes (until fully ported)
    location /api/ {
        proxy_pass http://daibilet_api_staging;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # Admin static (Vite) — until F4 Next admin
    location /admin/ {
        alias /var/www/daibilet/staging-admin/;
        try_files $uri $uri/ /admin/index.html;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # Next.js public (apps/web)
    location / {
        proxy_pass http://daibilet_web_staging;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
}
