# /etc/cron.d/daibilet-tasks
# Install: cp deploy/cron/daibilet-tasks /etc/cron.d/daibilet-tasks && chmod 644 ...
# Canonical MSK ops (INC.504.17 / INC.504.19): warm */12 + SSR healthcheck.
# Safe warm kill: pkill -f '[w]arm-hub-pages' (bracket trick; never bare warm-hub-pages).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# 1. Hub warm with timeout + flock
*/12 * * * * root DAIBILET_WEB_PORT=3001 flock -n /var/lock/daibilet-warm-hubs.lock timeout 90s bash -lc 'cd /opt/daibilet && /usr/bin/node scripts/warm-hub-pages.mjs' >>/var/log/daibilet/warm-hubs.log 2>&1

# 2. SSR healthcheck: curl fail OR TTFB>5s -> restart once (flock), kill warm safely.
# INC.504.19: do NOT use `TTFB=$(curl ... || echo 999)` - on connect hang curl prints 0.000000
# then appends 999 → multiline breaks bc and never restarts. Capture CODE separately.
* * * * * root flock -n /var/lock/daibilet-ssr-health.lock bash -lc 'URL=http://127.0.0.1:3001/; CODE=0; TTFB=$(curl -o /dev/null -s -w "\%{time_starttransfer}" --max-time 5 "$URL") || CODE=$?; BAD=0; if [ "$CODE" -ne 0 ]; then BAD=1; elif command -v bc >/dev/null && [ -n "$TTFB" ] && (( $(echo "$TTFB > 5" | bc -l) )); then BAD=1; fi; if [ "$BAD" -eq 1 ]; then MSG="SSR hung (TTFB=${TTFB:-na} curl=${CODE}). Executing systemctl restart daibilet-web."; echo "$(date -u +\%Y-\%m-\%dT\%H:\%M:\%SZ): $MSG" >> /var/log/daibilet/ssr-health.log; logger -t daibilet-ssr-health "$MSG"; systemctl restart daibilet-web; pkill -f "[w]arm-hub-pages" || true; fi'
