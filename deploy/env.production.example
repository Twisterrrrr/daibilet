NODE_ENV=production
PORT=4000
PUBLIC_PORT=3000
PUBLIC_APP_FILTER=@daibilet/public
RUN_LAUNCH_SMOKE=0

DATABASE_URL=postgresql://daibilet:<password>@127.0.0.1:5432/daibilet

DAIBILET_REQUIRE_ADMIN_AUTH=1
ADMIN_EMAIL=admin@daibilet.ru
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SHA256=
ADMIN_AUTH_REALM=Daibilet admin

DAIBILET_BACKEND_API_URL=https://api.daibilet.ru
DAIBILET_SITE_URL=https://daibilet.ru
PUBLIC_CORS_ORIGINS=https://daibilet.ru,https://www.daibilet.ru,https://admin.daibilet.ru

DAIBILET_TS_PUBLIC_HOME=1
DAIBILET_TS_PUBLIC_CATALOG=1
DAIBILET_TS_PUBLIC_EVENT=1
DAIBILET_TS_PUBLIC_CITY=1
DAIBILET_TS_PUBLIC_VENUE=1
DAIBILET_PUBLIC_PREWARM_BEFORE_LISTEN=1

USER_JWT_SECRET=
USER_JWT_ACCESS_TTL_SEC=900
USER_JWT_REFRESH_TTL_SEC=2592000

TICKETSCLOUD_API_TOKEN=
TICKETSCLOUD_WIDGET_TOKEN=
TICKETSCLOUD_GRPC_ENDPOINT=simple.ticketscloud.com:443
TICKETSCLOUD_WIDGET_BASE_URL=https://ticketscloud.org/v1/widgets/common

TEP_API_URL=https://api.teplohod.info/v1
TEP_WIDGET_ID=14208
TEP_WIDGET_BASE_URL=https://teplohod.info

# Next build/runtime.
# Keep empty in production, so public uses same-origin /api.
NEXT_PUBLIC_DAIBILET_API_URL=
NEXT_PUBLIC_SITE_URL=https://daibilet.ru
NEXT_PUBLIC_TEP_WIDGET_ID=14208
NEXT_PUBLIC_TC_WIDGET_TOKEN=

# Admin build.
VITE_DAIBILET_API_URL=/api
VITE_DAIBILET_PUBLIC_URL=https://daibilet.ru

# Smoke/acceptance helpers.
PUBLIC_BASE_URL=https://daibilet.ru
API_BASE_URL=https://api.daibilet.ru
ADMIN_BASE_URL=https://admin.daibilet.ru
SMOKE_ADMIN_PASSWORD=
SMOKE_ORDER_LOOKUP=
