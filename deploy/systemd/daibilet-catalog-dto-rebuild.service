# Out-of-process public catalog DTO rebuild (shared disk Soft-SWR).
# Preferred over in-process / child-spawn from daibilet-api (INC.504.5c).
# Install:
#   cp deploy/systemd/daibilet-catalog-dto-rebuild.service /etc/systemd/system/
#   cp deploy/systemd/daibilet-catalog-dto-rebuild.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now daibilet-catalog-dto-rebuild.timer
# Also set DAIBILET_CATALOG_REBUILD_MODE=off in /opt/daibilet/.env and restart daibilet-api.
[Unit]
Description=Daibilet public catalog DTO rebuild (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/daibilet
Environment=APP_DIR=/opt/daibilet
Environment=CATALOG_DTO_REBUILD_NICE=15
Nice=15
# Headroom for tsx/esbuild transpile spike + ~17MB JSON map (INC.504.5c).
MemoryHigh=900M
MemoryMax=1200M
ExecStart=/opt/daibilet/deploy/cron/rebuild-public-catalog-dto.sh timer
StandardOutput=append:/var/log/daibilet/catalog-dto-rebuild.log
StandardError=append:/var/log/daibilet/catalog-dto-rebuild.log

[Install]
WantedBy=multi-user.target
