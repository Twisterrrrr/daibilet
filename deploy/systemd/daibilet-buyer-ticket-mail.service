[Unit]
Description=Daibilet buyer ticket email delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/daibilet
EnvironmentFile=/opt/daibilet/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env bash -lc 'corepack pnpm --filter @daibilet/web ticket-mail:process -- --limit=50'
