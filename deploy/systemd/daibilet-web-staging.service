[Unit]
Description=Daibilet Next.js public (staging)
After=network.target daibilet-api-staging.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/daibilet-staging
EnvironmentFile=/opt/daibilet-staging/.env
Environment=DAIBILET_WEB_PORT=3000
Environment=NODE_ENV=production
Environment=CI=true
Environment=confirmModulesPurge=false
Environment=NODE_OPTIONS=--max-old-space-size=768
MemoryHigh=900M
MemoryMax=1200M
ExecStart=/usr/bin/env bash deploy/scripts/start-web-prod.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
