# Optional staging service with typed TS entrypoint + parity flags.
# cp deploy/systemd/daibilet-api-staging-ts.service.example /etc/systemd/system/daibilet-api-staging.service
# Enable DAIBILET_TS_* in /opt/daibilet-staging/.env before switching.

[Unit]
Description=Daibilet API (staging, TS handlers)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/daibilet-staging
EnvironmentFile=/opt/daibilet-staging/.env
ExecStart=/usr/bin/env npm --prefix apps/backend run start:ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
