[Unit]
Description=Run the past-event audit daily after catalog synchronization

[Timer]
# The host timezone is Etc/UTC: TC sync runs at 03:20 UTC (06:20 MSK).
# Run the read-only audit after it, at 04:30 UTC (07:30 MSK).
OnCalendar=*-*-* 04:30:00
Persistent=true
Unit=daibilet-past-event-audit.service

[Install]
WantedBy=timers.target
