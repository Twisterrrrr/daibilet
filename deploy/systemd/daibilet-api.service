[Unit]
Description=Daibilet API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/daibilet
EnvironmentFile=/opt/daibilet/.env
Environment="NODE_OPTIONS=--max-old-space-size=1024 --report-on-signal --report-signal=SIGUSR2 --report-directory=/var/log/daibilet/node-reports --report-exclude-env --report-exclude-network"
MemoryHigh=1800M
MemoryMax=2048M
MemorySwapMax=512M
OOMPolicy=continue
ExecStart=/usr/bin/env npm --prefix apps/backend run start:ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
