[Unit]
Description=Daibilet finance YooKassa checkout reconcile
Documentation=file:/opt/daibilet/docs/finance-159-smoke-runbook.md
After=network-online.target daibilet-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/daibilet
EnvironmentFile=/opt/daibilet/.env
Environment=NODE_ENV=production
Nice=10
CPUQuota=50%
MemoryMax=512M
ExecStart=/usr/bin/env npm run backend:checkout:yookassa:reconcile -- --apply --limit=100 --grace-minutes=10

