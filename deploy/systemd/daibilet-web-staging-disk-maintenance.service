[Unit]
Description=Daibilet staging web cache maintenance (online pruning)
ConditionPathExists=/opt/daibilet-staging/apps/web/.next/BUILD_ID

[Service]
Type=oneshot
Environment=APP_DIR=/opt/daibilet-staging
Environment=ROUTE_CACHE_LIMIT_MIB=1024
Environment=FETCH_CACHE_LIMIT_MIB=256
Environment=IMAGE_CACHE_LIMIT_MIB=256
Environment=REQUIRE_ROLLBACK=0
ExecStart=/usr/bin/env bash /opt/daibilet/deploy/scripts/maintain-web-disk.sh --apply
