{
  "name": "@daibilet/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Daibilet event marketplace monorepo",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "generate": "pnpm db:generate",
    "dev:backend": "pnpm --filter @daibilet/backend dev:ts",
    "dev:public": "pnpm --filter @daibilet/public dev",
    "dev:admin": "pnpm --filter @daibilet/admin dev",
    "build:apps": "pnpm --filter @daibilet/backend build && pnpm --filter @daibilet/public build && pnpm --filter @daibilet/admin build",
    "build": "pnpm generate && pnpm typecheck && pnpm build:apps",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @daibilet/backend test:ts",
    "test:integration": "pnpm --filter @daibilet/backend test:integration",
    "check": "pnpm build && pnpm test && pnpm test:integration",
    "backend:serve": "pnpm --filter @daibilet/backend dev",
    "backend:dev": "pnpm --filter @daibilet/backend dev",
    "backend:dev:ts": "pnpm --filter @daibilet/backend dev:ts",
    "backend:typecheck": "pnpm --filter @daibilet/backend typecheck",
    "backend:test:ts": "pnpm --filter @daibilet/backend test:ts",
    "backend:catalog:parity": "pnpm --filter @daibilet/backend catalog:parity",
    "backend:event:parity": "pnpm --filter @daibilet/backend event:parity",
    "backend:city:parity": "pnpm --filter @daibilet/backend city:parity",
    "backend:venue:parity": "pnpm --filter @daibilet/backend venue:parity",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:validate": "pnpm --filter @daibilet/db db:validate",
    "db:migrate": "pnpm --filter @daibilet/db db:migrate",
    "db:deploy": "pnpm --filter @daibilet/db db:deploy",
    "db:generate": "pnpm --filter @daibilet/db db:generate",
    "db:typecheck": "pnpm --filter @daibilet/db typecheck",
    "db:smoke": "pnpm --filter @daibilet/db db:smoke",
    "db:seed:tc-sql": "node scripts/db-build-tc-seed-sql.js",
    "tc:events": "node scripts/tc-sample-events.js",
    "tc:catalog": "node scripts/tc-sample-catalog.js",
    "tc:count": "node scripts/tc-count-events.js",
    "tc:full-sync": "node scripts/tc-full-sync.js",
    "tc:orders": "node scripts/tc-sync-orders.js",
    "tc:city-routing": "node scripts/tc-city-routing-summary.js",
    "landing:snapshot": "node scripts/landing-snapshot.mjs --write",
    "landing:audit": "node scripts/landing-audit.mjs",
    "tep:landing-diagnose": "node scripts/tep-landing-diagnose.mjs",
    "tep:import-fixtures": "node scripts/tep-import-fixtures.js",
    "tep:sync": "node scripts/tep-import-fixtures.js",
    "tep:bridge": "node scripts/teplohod-fixture-bridge.js",
    "tep:fixture-bridge": "node scripts/teplohod-fixture-bridge.js",
    "public:data": "node scripts/build-public-prototype-data.js",
    "public:serve": "pnpm --filter @daibilet/public dev",
    "public:build": "pnpm --filter @daibilet/public build",
    "public:perf": "node scripts/public-performance-snapshot.mjs",
    "smoke:launch": "node scripts/launch-smoke.mjs",
    "acceptance:web": "node scripts/web-acceptance.mjs",
    "preflight:deploy": "node scripts/deploy-preflight.mjs",
    "readiness:admin": "node scripts/admin-readiness.mjs",
    "admin:data": "node scripts/build-admin-prototype-data.js",
    "admin:serve": "pnpm --filter @daibilet/admin dev",
    "admin:dev": "pnpm --filter @daibilet/admin dev",
    "admin:build": "pnpm --filter @daibilet/admin build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "dotenv": "^17.4.2"
  }
}
