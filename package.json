{
  "name": "@daibilet/workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Daibilet event marketplace monorepo",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "generate": "pnpm db:generate",
    "dev:web": "pnpm --filter @daibilet/web dev",
    "build:web": "pnpm --filter @daibilet/web build",
    "web:dev": "pnpm --filter @daibilet/web dev",
    "web:build": "pnpm generate && pnpm --filter @daibilet/web build",
    "web:typecheck": "pnpm --filter @daibilet/web typecheck",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm generate && pnpm typecheck && pnpm build:web",
    "backend:serve": "pnpm --filter @daibilet/backend dev",
    "backend:dev": "pnpm --filter @daibilet/backend dev",
    "backend:dev:ts": "pnpm --filter @daibilet/backend dev:ts",
    "backend:typecheck": "pnpm --filter @daibilet/backend typecheck",
    "backend:test:ts": "pnpm --filter @daibilet/backend test:ts",
    "backend:catalog:parity": "pnpm --filter @daibilet/backend catalog:parity",
    "backend:event:parity": "pnpm --filter @daibilet/backend event:parity",
    "backend:city:parity": "pnpm --filter @daibilet/backend city:parity",
    "backend:venue:parity": "pnpm --filter @daibilet/backend venue:parity",
    "backend:next:parity": "pnpm --filter @daibilet/backend next:parity",
    "backend:admin-events:parity": "pnpm --filter @daibilet/backend admin-events:parity",
    "backend:admin-orders:parity": "pnpm --filter @daibilet/backend admin-orders:parity",
    "worker": "pnpm --filter @daibilet/worker start",
    "worker:health": "pnpm --filter @daibilet/worker health",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:validate": "pnpm --filter @daibilet/db db:validate",
    "db:migrate": "pnpm --filter @daibilet/db db:migrate",
    "db:deploy": "pnpm --filter @daibilet/db db:deploy",
    "db:generate": "pnpm --filter @daibilet/db db:generate",
    "deploy:preflight": "bash scripts/deploy-preflight.sh",
    "db:typecheck": "pnpm --filter @daibilet/db db:typecheck",
    "db:smoke": "pnpm --filter @daibilet/db db:smoke",
    "db:seed:tc-sql": "node scripts/db-build-tc-seed-sql.js",
    "tc:events": "node scripts/tc-sample-events.js",
    "tc:catalog": "node scripts/tc-sample-catalog.js",
    "tc:count": "node scripts/tc-count-events.js",
    "tc:full-sync": "node scripts/tc-full-sync.js",
    "tc:import": "node scripts/tc-import-catalog.js && node scripts/ensure-catalog-covers.js",
    "tc:sync": "node scripts/tc-sync.js",
    "tc:sync:help": "node scripts/tc-sync.js --help",
    "check:widgets": "node scripts/widget-readiness-check.mjs",
    "check:sync-invariants": "node scripts/sync-invariants-check.js",
    "check:post-deploy": "bash scripts/post-deploy-check.sh",
    "check:parity": "bash scripts/run-parity-check.sh",
    "revalidate:home": "node scripts/revalidate-next-home.mjs",
    "hp:merge": "node scripts/apply-harry-potter-catalog-merge.js",
    "hp:enrich-combos": "node scripts/apply-harry-potter-combo-enrichment.js",
    "launch:widgeturl-stats": "node scripts/launch-widgeturl-stats.js",
    "launch:staging-smoke": "bash scripts/launch-staging-smoke.sh",
    "launch:staging-smoke-next": "bash scripts/launch-staging-smoke-next.sh",
    "launch:prod-smoke-next": "bash scripts/launch-prod-smoke-next.sh",
    "tc:orders": "node scripts/tc-sync-orders.js",
    "tc:city-routing": "node scripts/tc-city-routing-summary.js",
    "blog:sync-bodies": "node scripts/blog-sync-static-bodies.js",
    "blog:upsert": "node scripts/blog-upsert-articles.js",
    "blog:check-inline": "node scripts/blog-check-inline-images.js",
    "blog:weekly-digest": "node scripts/blog-weekly-digest.js",
    "reviews:requests": "node --import ./apps/backend/node_modules/tsx/dist/loader.mjs scripts/send-review-requests.js",
    "landing:snapshot": "node scripts/landing-snapshot.mjs --write",
    "landing:audit": "node scripts/landing-audit.mjs",
    "audit:listings": "node --import ./apps/backend/node_modules/tsx/dist/loader.mjs scripts/audit-listings.js",
    "tep:landing-diagnose": "node scripts/tep-landing-diagnose.mjs",
    "tep:import-fixtures": "node scripts/tep-import-fixtures.js",
    "covers:ensure": "node scripts/ensure-catalog-covers.js",
    "tep:sync": "node scripts/tep-import-fixtures.js && node scripts/ensure-catalog-covers.js && node scripts/revalidate-next-home.mjs",
    "tep:orders": "node scripts/tep-sync-orders.js",
    "tep:bridge": "node scripts/teplohod-fixture-bridge.js",
    "tep:fixture-bridge": "node scripts/teplohod-fixture-bridge.js",
    "public:data": "node scripts/build-public-prototype-data.js",
    "public:serve": "pnpm --filter @tours/public dev",
    "public:build": "pnpm --filter @tours/public build",
    "public:perf": "node scripts/public-performance-snapshot.mjs",
    "admin:data": "node scripts/build-admin-prototype-data.js",
    "admin:serve": "pnpm --filter @tours/admin dev",
    "admin:dev": "pnpm --filter @tours/admin dev",
    "admin:build": "pnpm --filter @tours/admin build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "dotenv": "^17.4.2"
  }
}
