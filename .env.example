NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://daibilet:change-me@127.0.0.1:5432/daibilet

# Admin/API protection. Use ADMIN_PASSWORD_HASH=sha256:<hex> for production when possible.
DAIBILET_REQUIRE_ADMIN_AUTH=1
DAIBILET_TS_PUBLIC_CATALOG=1
DAIBILET_TS_PUBLIC_EVENT=1
DAIBILET_TS_PUBLIC_CITY=1
DAIBILET_TS_PUBLIC_VENUE=1
DAIBILET_TS_ADMIN_EVENTS=1
DAIBILET_TS_ADMIN_ORDERS=1
DAIBILET_PUBLIC_PREWARM_BEFORE_LISTEN=1
# Optional m2m auth for catalog -> finance public projection reads.
DAIBILET_FINANCE_PROJECTION_TOKEN=
ADMIN_EMAIL=admin@daibilet.ru
ADMIN_PASSWORD=
USER_JWT_SECRET=
PUBLIC_SITE_URL=https://daibilet.ru
# Buyer email verification. Without SMTP, request endpoint returns 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Dedicated order-result signing secret. Falls back to USER_JWT_SECRET during migration.
DAIBILET_ORDER_ACCESS_SECRET=
# Enable only after catalog stores orderAccessToken and sends x-daibilet-order-access.
DAIBILET_REQUIRE_ORDER_ACCESS=0
USER_JWT_ACCESS_TTL_SEC=900
USER_JWT_REFRESH_TTL_SEC=2592000
SUPPLIER_PORTAL_BASE_URL=https://supplier.daibilet.ru
SUPPLIER_INVITE_TTL_HOURS=48
PUBLIC_CORS_ORIGINS=https://daibilet.ru,https://www.daibilet.ru,https://admin.daibilet.ru
ADMIN_PASSWORD_HASH=
ADMIN_AUTH_REALM=Daibilet admin

TICKETSCLOUD_API_TOKEN=
TICKETSCLOUD_WIDGET_TOKEN=
TICKETSCLOUD_GRPC_ENDPOINT=simple.ticketscloud.com:443
TICKETSCLOUD_WIDGET_BASE_URL=https://ticketscloud.org/v1/widgets/common

# Teplohod: каталог по белому IP, токен не нужен. На проде — https://api.teplohod.info/v1
# Локально без allowlist — fixture-bridge: npm run tep:fixture-bridge и TEP_API_URL ниже
TEP_API_URL=http://127.0.0.1:8787/v1
# Опционально, если Teplohod попросит User-Agent в allowlist:
# TEP_USER_AGENT=Daibilet/1.0
TEP_WIDGET_ID=14460
TEP_WIDGET_BASE_URL=https://teplohod.info
# Orders (account API, NOT catalog IP API). Without token npm run tep:orders → BLOCKED.
# TEP_ORDERS_API_URL=https://account.teplohod.info/api/orders
# TEP_ORDERS_TOKEN=
# TEP_ORDERS_AUTH=both
# TEP_ORDERS_LOOKBACK_DAYS=3

# Build-time env for Vite apps.
# Public site:
# VITE_DAIBILET_API_URL=https://api.daibilet.ru
# VITE_TEP_WIDGET_ID=14460
# Next.js apps/web (client widgets / analytics):
# NEXT_PUBLIC_TC_WIDGET_TOKEN=
# NEXT_PUBLIC_TEP_WIDGET_ID=14460
# NEXT_PUBLIC_YANDEX_METRIKA_ID=106786540
# IndexNow (Yandex + Bing-compatible). Server-only — NEVER NEXT_PUBLIC_.
# Key files: /indexnow-key.txt and /{INDEXNOW_KEY}.txt (deploy writes public/).
# INDEXNOW_KEY=

# Admin AI rewrite of event descriptions (server-only, backend).
# OPENAI_API_KEY=
# OPENAI_REWRITE_MODEL=gpt-4.1-mini

# Finance projection (catalog → .159 read-only). Server-only.
# From MSK prefer reachable URL; if DNS missing use IP + Host header:
# FINANCE_API_BASE_URL=http://85.193.80.159
# FINANCE_API_HOST=finance-api.daibilet.ru
# Optional m2m (when set on finance):
# DAIBILET_FINANCE_PROJECTION_TOKEN=
# FINANCE_PROJECTION_TOKEN=
# Browser checkout deep-links (relative checkoutPath from projection):
# FINANCE_CHECKOUT_BASE_URL=https://pay.daibilet.ru
# NEXT_PUBLIC_FINANCE_CHECKOUT_BASE_URL=https://pay.daibilet.ru
# City hub museums block min published products (default 1):
# CITY_ADMISSION_MIN_PUBLISHED=1

# Admin site:
# VITE_DAIBILET_API_URL=/api
# VITE_DAIBILET_PUBLIC_URL=https://daibilet.ru

# Phase 2 checkout sandbox. Keep disabled on prod until smoke and legal/fiscal flow are approved.
DAIBILET_STUB_CHECKOUT=0
DAIBILET_YOOKASSA_CHECKOUT=0
DAIBILET_YOOKASSA_VERIFY_WEBHOOK=1
# Engineering-only supplier purchase routes. Keep 0 in production except a controlled QA window.
DAIBILET_SUPPLIER_CHECKOUT_SMOKE=0
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_BASE_URL=https://daibilet.ru

# Internal admin finance bridge. Configure only on the web and finance services.
# Set the assertion secret to the same random value (at least 32 bytes) in both environments.
# FINANCE_API_BASE_URL=
# DAIBILET_FINANCE_ADMIN_READ_TOKEN=
# DAIBILET_FINANCE_ADMIN_OPERATION_TOKEN=
# DAIBILET_FINANCE_ACTOR_ASSERTION_SECRET=
