NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://daibilet:change-me@127.0.0.1:5432/daibilet

# Admin/API protection. Use ADMIN_PASSWORD_HASH=sha256:<hex> for production when possible.
DAIBILET_REQUIRE_ADMIN_AUTH=1
DAIBILET_TS_PUBLIC_CATALOG=1
DAIBILET_TS_PUBLIC_EVENT=1
DAIBILET_TS_PUBLIC_CITY=1
DAIBILET_TS_PUBLIC_VENUE=1
DAIBILET_TS_ADMIN_EVENTS=1
DAIBILET_TS_ADMIN_ORDERS=1
DAIBILET_PUBLIC_PREWARM_BEFORE_LISTEN=1
ADMIN_EMAIL=admin@daibilet.ru
ADMIN_PASSWORD=
USER_JWT_SECRET=
USER_JWT_ACCESS_TTL_SEC=900
USER_JWT_REFRESH_TTL_SEC=2592000
PUBLIC_CORS_ORIGINS=https://daibilet.ru,https://www.daibilet.ru,https://admin.daibilet.ru
ADMIN_PASSWORD_HASH=
ADMIN_AUTH_REALM=Daibilet admin

TICKETSCLOUD_API_TOKEN=
TICKETSCLOUD_WIDGET_TOKEN=
TICKETSCLOUD_GRPC_ENDPOINT=simple.ticketscloud.com:443
TICKETSCLOUD_WIDGET_BASE_URL=https://ticketscloud.org/v1/widgets/common

# Teplohod: каталог по белому IP, токен не нужен. На проде — https://api.teplohod.info/v1
# Локально без allowlist — fixture-bridge: npm run tep:fixture-bridge и TEP_API_URL ниже
TEP_API_URL=http://127.0.0.1:8787/v1
# Опционально, если Teplohod попросит User-Agent в allowlist:
# TEP_USER_AGENT=Daibilet/1.0
TEP_WIDGET_ID=14208
TEP_WIDGET_BASE_URL=https://teplohod.info
# Orders (account API, NOT catalog IP API). Without token npm run tep:orders → BLOCKED.
# TEP_ORDERS_API_URL=https://account.teplohod.info/api/orders
# TEP_ORDERS_TOKEN=
# TEP_ORDERS_AUTH=both
# TEP_ORDERS_LOOKBACK_DAYS=3

# Build-time env for Vite apps.
# Public site:
# VITE_DAIBILET_API_URL=https://api.daibilet.ru
# VITE_TEP_WIDGET_ID=14208
# Next.js apps/web (client widgets / analytics):
# NEXT_PUBLIC_TC_WIDGET_TOKEN=
# NEXT_PUBLIC_TEP_WIDGET_ID=14208
# NEXT_PUBLIC_YANDEX_METRIKA_ID=106786540
# Admin site:
# VITE_DAIBILET_API_URL=/api
# VITE_DAIBILET_PUBLIC_URL=https://daibilet.ru

# Phase 2 checkout sandbox. Keep disabled on prod until smoke and legal/fiscal flow are approved.
DAIBILET_STUB_CHECKOUT=0
DAIBILET_YOOKASSA_CHECKOUT=0
DAIBILET_YOOKASSA_VERIFY_WEBHOOK=1
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_BASE_URL=https://daibilet.ru
