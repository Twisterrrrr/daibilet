model Source {
  id        String     @id @default(cuid())
  code      SourceCode @unique
  name      String
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  syncRuns      SourceSyncRun[]
  rawRecords    RawImportRecord[]
  eventLinks    EventSourceLink[]
  providerLinks ProviderLink[]
  orderLinks    ExternalOrder[]
}

model SourceSyncRun {
  id         String     @id @default(cuid())
  sourceId   String
  status     SyncStatus @default(RUNNING)
  mode       String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  stats      Json?
  error      String?

  source Source @relation(fields: [sourceId], references: [id])

  @@index([sourceId, startedAt])
}

model RawImportRecord {
  id          String   @id @default(cuid())
  sourceId    String
  entityType  String
  externalId  String
  payload     Json
  payloadHash String?
  importedAt  DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, entityType, externalId])
}

model Event {
  id                    String              @id @default(cuid())
  title                 String
  slug                  String              @unique
  description           String?
  kind                  EventKind
  status                PublishStatus       @default(REVIEW)
  purchaseFlow          PurchaseFlow        @default(EXTERNAL)
  managementMode        EventManagementMode @default(SOURCE_MANAGED)
  sourceStatus          String?
  ageLimit              String?
  imageUrl              String?
  seoH1                 String?
  seoTitle              String?
  seoDescription        String?
  canonicalPath         String?
  isIndexable           Boolean             @default(true)
  priceFromRub          Int?
  ticketsVacant         Int?
  primaryCityId         String?
  venueId               String?
  categoryId            String?
  primarySubcategoryId  String?
  supplierId            String?
  createdByType         EventActorType      @default(SYSTEM)
  createdBySiteUserId   String?
  submittedBySiteUserId String?
  submittedAt           DateTime?
  moderatedBySiteUserId String?
  moderatedAt           DateTime?
  moderationComment     String?
  scheduleLocked        Boolean             @default(true)
  defaultCapacityTotal  Int?
  openDateValidFrom     DateTime?
  openDateValidTo       DateTime?
  openDateValidDays     Int?
  salesStartsAt         DateTime?
  salesEndsAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  primaryCity        City?        @relation(fields: [primaryCityId], references: [id])
  venue              Venue?       @relation(fields: [venueId], references: [id])
  category           Category?    @relation(fields: [categoryId], references: [id])
  primarySubcategory Subcategory? @relation(fields: [primarySubcategoryId], references: [id])
  supplier           Supplier?    @relation("PrimarySupplierEvents", fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy          SiteUser?    @relation("EventCreatedBy", fields: [createdBySiteUserId], references: [id], onDelete: SetNull)
  submittedBy        SiteUser?    @relation("EventSubmittedBy", fields: [submittedBySiteUserId], references: [id], onDelete: SetNull)
  moderatedBy        SiteUser?    @relation("EventModeratedBy", fields: [moderatedBySiteUserId], references: [id], onDelete: SetNull)

  sessions        EventSession[]
  offers          EventOffer[]
  sourceLinks     EventSourceLink[]
  providerLinks   ProviderLink[]
  subcategories   EventSubcategory[]
  tags            EventTag[]
  qualityIssues   QualityIssue[]
  landingMatches  LandingMatch[]
  supplierLinks   SupplierEvent[]
  checkoutItems   CheckoutItem[]
  tripPlanItems   TripPlanItem[]
  commissionRules SupplierCommissionRule[]
  changeRequests  EventChangeRequest[]
  changeLogs      EventChangeLog[]
  reviews         Review[]
  externalReviews ExternalReview[]
  reviewRequests  ReviewRequest[]
  override        EventOverride?

  @@index([status])
  @@index([purchaseFlow])
  @@index([managementMode, status])
  @@index([primaryCityId])
  @@index([venueId])
  @@index([categoryId])
  @@index([supplierId, status])
}

model EventOverride {
  id               String         @id @default(cuid())
  eventId          String         @unique
  title            String?
  description      String?
  shortDescription String?
  imageUrl         String?
  seoH1            String?
  seoTitle         String?
  seoDescription   String?
  canonicalPath    String?
  isIndexable      Boolean?
  editorStatus     PublishStatus?
  /// Admin-defined key to merge distinct ticket products into one multi-purchase hub page.
  mergeGroupKey    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([mergeGroupKey])
}

model EventSourceLink {
  id             String   @id @default(cuid())
  eventId        String
  sourceId       String
  externalId     String
  metaExternalId String?
  sourceUrl      String?
  rawRecordId    String?
  updatedAt      DateTime @updatedAt

  event  Event  @relation(fields: [eventId], references: [id])
  source Source @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, externalId])
  @@index([eventId])
  @@index([sourceId, metaExternalId])
}

model EventSession {
  id            String    @id @default(cuid())
  eventId       String
  startsAt      DateTime?
  endsAt        DateTime?
  sourceStatus  String?
  priceFromRub  Int?
  ticketsVacant Int?
  capacityTotal Int?
  capacitySold  Int       @default(0)
  isActive      Boolean   @default(true)
  cancelledAt   DateTime?
  cancelReason  String?
  externalId    String?

  event         Event          @relation(fields: [eventId], references: [id])
  providerLinks ProviderLink[]
  checkoutItems CheckoutItem[]
  tripPlanItems TripPlanItem[]

  @@index([eventId, startsAt])
  @@index([startsAt])
  @@index([eventId, isActive, startsAt])
  @@index([externalId])
}

model EventOffer {
  id            String     @id @default(cuid())
  eventId       String
  sourceCode    SourceCode
  title         String?
  priceRub      Int?
  oldPriceRub   Int?
  capacityTotal Int?
  groupSize     Int        @default(1)
  weekdayMask   Int?
  widgetUrl     String?
  deeplinkUrl   String?
  payload       Json?
  active        Boolean    @default(true)

  event         Event          @relation(fields: [eventId], references: [id])
  providerLinks ProviderLink[]
  checkoutItems CheckoutItem[]

  @@index([eventId, active, priceRub])
  @@index([sourceCode])
}

model AdmissionProduct {
  id                     String                @id @default(cuid())
  slug                   String                @unique
  title                  String
  shortTitle             String?
  description            String?
  shortDescription       String?
  type                   AdmissionProductType  @default(OTHER)
  status                 PublishStatus         @default(REVIEW)
  purchaseFlow           PurchaseFlow          @default(PLATFORM)
  managementMode         EventManagementMode   @default(DAIBILET_MANAGED)
  sourceCode             SourceCode            @default(MANUAL)
  sourceStatus           String?
  imageUrl               String?
  seoH1                  String?
  seoTitle               String?
  seoDescription         String?
  canonicalPath          String?
  isIndexable            Boolean               @default(true)
  priceFromRub           Int?
  ticketsVacant          Int?
  defaultCapacityTotal   Int?
  validityMode           AdmissionValidityMode @default(OPEN_DATE)
  validFrom              DateTime?
  validTo                DateTime?
  validDaysAfterPurchase Int?
  salesStartsAt          DateTime?
  salesEndsAt            DateTime?
  cityId                 String?
  venueId                String
  categoryId             String?
  primarySubcategoryId   String?
  supplierId             String?
  createdByType          EventActorType        @default(SYSTEM)
  createdBySiteUserId    String?
  moderatedBySiteUserId  String?
  moderatedAt            DateTime?
  moderationComment      String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  city               City?                    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  venue              Venue                    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category           Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  primarySubcategory Subcategory?             @relation(fields: [primarySubcategoryId], references: [id], onDelete: SetNull)
  supplier           Supplier?                @relation("PrimarySupplierAdmissionProducts", fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy          SiteUser?                @relation("AdmissionProductCreatedBy", fields: [createdBySiteUserId], references: [id], onDelete: SetNull)
  moderatedBy        SiteUser?                @relation("AdmissionProductModeratedBy", fields: [moderatedBySiteUserId], references: [id], onDelete: SetNull)
  offers             AdmissionOffer[]
  checkoutItems      CheckoutItem[]
  commissionRules    SupplierCommissionRule[]

  @@index([status])
  @@index([type, status])
  @@index([purchaseFlow])
  @@index([managementMode, status])
  @@index([cityId])
  @@index([venueId, status])
  @@index([categoryId])
  @@index([supplierId, status])
  @@index([validityMode, status])
}

model AdmissionOffer {
  id                 String     @id @default(cuid())
  admissionProductId String
  sourceCode         SourceCode
  title              String?
  priceRub           Int?
  oldPriceRub        Int?
  capacityTotal      Int?
  groupSize          Int        @default(1)
  weekdayMask        Int?
  widgetUrl          String?
  deeplinkUrl        String?
  payload            Json?
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  admissionProduct AdmissionProduct  @relation(fields: [admissionProductId], references: [id], onDelete: Cascade)
  checkoutItems    CheckoutItem[]
  fulfillmentItems FulfillmentItem[]

  @@index([admissionProductId, active, priceRub])
  @@index([sourceCode])
}

model ProviderLink {
  id               String             @id @default(cuid())
  sourceId         String
  entityKind       ProviderEntityKind
  eventId          String?
  sessionId        String?
  offerId          String?
  venueId          String?
  externalId       String
  externalParentId String             @default("")
  sourceUrl        String?
  rawRecordId      String?
  payload          Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  source  Source        @relation(fields: [sourceId], references: [id])
  event   Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session EventSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  offer   EventOffer?   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  venue   Venue?        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([sourceId, entityKind, externalId, externalParentId])
  @@index([eventId])
  @@index([sessionId])
  @@index([offerId])
  @@index([venueId])
  @@index([sourceId, entityKind])
}

model Category {
  id       String @id @default(cuid())
  slug     String @unique
  title    String
  position Int    @default(0)

  events            Event[]
  admissionProducts AdmissionProduct[]
  subcategories     Subcategory[]
  commissionRules   SupplierCommissionRule[]
}

model Subcategory {
  id         String @id @default(cuid())
  categoryId String
  slug       String @unique
  title      String
  position   Int    @default(0)

  category                 Category           @relation(fields: [categoryId], references: [id])
  primaryEvents            Event[]
  primaryAdmissionProducts AdmissionProduct[]
  events                   EventSubcategory[]
}

model EventSubcategory {
  eventId       String
  subcategoryId String
  isPrimary     Boolean @default(false)

  event       Event       @relation(fields: [eventId], references: [id])
  subcategory Subcategory @relation(fields: [subcategoryId], references: [id])

  @@id([eventId, subcategoryId])
  @@index([subcategoryId])
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  events EventTag[]
}

model EventTag {
  eventId String
  tagId   String

  event Event @relation(fields: [eventId], references: [id])
  tag   Tag   @relation(fields: [tagId], references: [id])

  @@id([eventId, tagId])
  @@index([tagId])
}

model Region {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  cities City[]
}

model City {
  id             String  @id @default(cuid())
  regionId       String?
  slug           String  @unique
  title          String
  sourceTitle    String?
  introTitle     String?
  introText      String?
  heroImageUrl   String?
  seoH1          String?
  seoTitle       String?
  seoDescription String?
  canonicalPath  String?
  isDestination  Boolean @default(false)

  region            Region?            @relation(fields: [regionId], references: [id])
  venues            Venue[]
  events            Event[]
  admissionProducts AdmissionProduct[]
  landings          Landing[]
  articles          Article[]
  tripPlans         TripPlan[]
}

model Venue {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  description      String?
  shortDescription String?
  heroImageUrl     String?
  seoH1            String?
  seoTitle         String?
  seoDescription   String?
  canonicalPath    String?
  isIndexable      Boolean         @default(true)
  cityId           String?
  address          String?
  latitude         Float?
  longitude        Float?
  kind             VenueKind       @default(OTHER)
  pageStatus       VenuePageStatus @default(NONE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  city              City?              @relation(fields: [cityId], references: [id])
  events            Event[]
  admissionProducts AdmissionProduct[]
  aliases           VenueAlias[]
  providerLinks     ProviderLink[]
  supplierLinks     SupplierVenue[]
  tripPlanItems     TripPlanItem[]
  reviews           Review[]
  externalReviews   ExternalReview[]
}

model VenueAlias {
  id         String     @id @default(cuid())
  venueId    String
  sourceCode SourceCode
  externalId String?
  title      String
  address    String?

  venue Venue @relation(fields: [venueId], references: [id])
}

model Landing {
  id          String        @id @default(cuid())
  type        LandingType   @default(MULTI_CITY)
  slug        String        @unique
  title       String
  subtitle    String?
  description String?
  status      PublishStatus @default(REVIEW)
  cityId      String?
  themeId     String?
  rules       Json

  heroTitle          String?
  heroSubtitle       String?
  heroBadge          String?
  heroImageUrl       String?
  heroMobileImageUrl String?
  templateType       String?
  layoutVariant      String?
  surfaceVariant     String?

  seoH1              String?
  seoTitle           String?
  seoDescription     String?
  ogImageUrl         String?
  canonicalMode      CanonicalMode @default(SELF)
  canonicalUrl       String?
  canonicalLandingId String?
  isIndexable        Boolean       @default(false)
  isActive           Boolean       @default(true)
  publishedAt        DateTime?
  sortOrder          Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city         City?                 @relation(fields: [cityId], references: [id])
  theme        LandingTheme?         @relation(fields: [themeId], references: [id])
  matches      LandingMatch[]
  blocks       LandingContentBlock[]
  relatedLinks LandingRelatedLink[]

  @@index([type, isActive, isIndexable])
  @@index([cityId, slug])
}

model LandingMatch {
  landingId String
  eventId   String
  score     Int    @default(0)
  reasons   Json?

  landing Landing @relation(fields: [landingId], references: [id])
  event   Event   @relation(fields: [eventId], references: [id])

  @@id([landingId, eventId])
}

model LandingTheme {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  subtitle              String?
  defaultHeroTitle      String?
  defaultHeroBody       String?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  coverImageUrl         String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  landings Landing[]
}

model LandingContentBlock {
  id              String           @id @default(cuid())
  landingId       String
  type            LandingBlockType
  variant         String?
  title           String?
  subtitle        String?
  eyebrow         String?
  body            String?
  richTextJson    Json?
  payload         Json?
  assetUrl        String?
  mobileAssetUrl  String?
  isEnabled       Boolean          @default(true)
  sortOrder       Int              @default(0)
  visibilityRules Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  landing Landing @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@index([landingId, sortOrder])
}

model LandingRelatedLink {
  id        String @id @default(cuid())
  landingId String
  title     String
  href      String
  kind      String
  sortOrder Int    @default(0)

  landing Landing @relation(fields: [landingId], references: [id], onDelete: Cascade)

  @@index([landingId, sortOrder])
