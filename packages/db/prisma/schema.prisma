  periodStart       DateTime
  periodEnd         DateTime
  grossKopecks      Int              @default(0)
  commissionKopecks Int              @default(0)
  adjustmentKopecks Int              @default(0)
  netKopecks        Int              @default(0)
  currency          String           @default("RUB")
  status            SettlementStatus @default(DRAFT)
  payoutId          String?
  approvedAt        DateTime?
  finalizedAt       DateTime?
  paidAt            DateTime?
  metaJson          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  supplier  Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  documents SupplierDocument[]

  @@index([supplierId, periodStart, periodEnd])
  @@index([status])
}

model SupplierDocument {
  id           String                 @id @default(cuid())
  supplierId   String
  reportId     String?
  settlementId String?
  type         SupplierDocumentType
  status       SupplierDocumentStatus @default(DRAFT)
  title        String
  payloadJson  Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  supplier   Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  report     SupplierReport?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
  settlement SupplierSettlement?    @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  files      SupplierDocumentFile[]

  @@index([supplierId])
  @@index([reportId])
  @@index([settlementId])
  @@index([status])
}

model SupplierDocumentFile {
  id                 String                   @id @default(cuid())
  supplierDocumentId String
  kind               SupplierDocumentFileKind
  storageKey         String
  fileName           String?
  mimeType           String?
  sizeBytes          Int?
  createdAt          DateTime                 @default(now())

  document SupplierDocument @relation(fields: [supplierDocumentId], references: [id], onDelete: Cascade)

  @@index([supplierDocumentId])
}

model SupplierDispute {
  id               String                        @id @default(cuid())
  supplierReportId String
  supplierId       String
  status           SupplierDisputeStatus         @default(OPEN)
  reasonCategory   SupplierDisputeReasonCategory
  reasonText       String?
  resolutionText   String?
  openedByUserId   String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  report   SupplierReport @relation(fields: [supplierReportId], references: [id], onDelete: Cascade)
  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierReportId])
  @@index([supplierId, status])
}

model TripPlan {
  id                String         @id @default(cuid())
  publicCode        String?        @unique
  siteUserId        String?
  cityId            String?
  title             String?
  status            TripPlanStatus @default(DRAFT)
  startsAt          DateTime?
  endsAt            DateTime?
  travellerSnapshot Json?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  siteUser SiteUser?      @relation(fields: [siteUserId], references: [id])
  city     City?          @relation(fields: [cityId], references: [id])
  items    TripPlanItem[]
  vouchers TripVoucher[]

  @@index([siteUserId, createdAt])
  @@index([cityId, startsAt])
  @@index([status, createdAt])
}

model TripPlanItem {
  id             String    @id @default(cuid())
  tripPlanId     String
  eventId        String?
  sessionId      String?
  venueId        String?
  checkoutItemId String?
  sortOrder      Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  title          String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tripPlan     TripPlan          @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  event        Event?            @relation(fields: [eventId], references: [id])
  session      EventSession?     @relation(fields: [sessionId], references: [id])
  venue        Venue?            @relation(fields: [venueId], references: [id])
  checkoutItem CheckoutItem?     @relation(fields: [checkoutItemId], references: [id], onDelete: SetNull)
  voucherItems TripVoucherItem[]

  @@index([tripPlanId, sortOrder])
  @@index([eventId])
  @@index([sessionId])
  @@index([venueId])
  @@index([checkoutItemId])
}

model TripVoucher {
  id              String            @id @default(cuid())
  tripPlanId      String
  checkoutOrderId String?
  code            String            @unique
  status          TripVoucherStatus @default(DRAFT)
  issuedAt        DateTime?
  cancelledAt     DateTime?
  payload         Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tripPlan      TripPlan          @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  checkoutOrder CheckoutOrder?    @relation(fields: [checkoutOrderId], references: [id], onDelete: SetNull)
  items         TripVoucherItem[]

  @@index([tripPlanId, status])
  @@index([checkoutOrderId])
  @@index([status, createdAt])
}

model TripVoucherItem {
  id             String   @id @default(cuid())
  tripVoucherId  String
  tripPlanItemId String?
  checkoutItemId String?
  title          String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  tripVoucher  TripVoucher   @relation(fields: [tripVoucherId], references: [id], onDelete: Cascade)
  tripPlanItem TripPlanItem? @relation(fields: [tripPlanItemId], references: [id], onDelete: SetNull)
  checkoutItem CheckoutItem? @relation(fields: [checkoutItemId], references: [id], onDelete: SetNull)

  @@index([tripVoucherId, sortOrder])
  @@index([tripPlanItemId])
  @@index([checkoutItemId])
}

model Review {
  id              String       @id @default(cuid())
  eventId         String?
  venueId         String?
  supplierId      String?
  siteUserId      String?
  checkoutOrderId String?
  externalOrderId String?
  rating          Int
  title           String?
  text            String
  authorName      String
  authorEmail     String
  isVerified      Boolean      @default(false)
  voucherCode     String?
  /// Public-facing purchase ref (ticket/order), never full PII in UI.
  purchaseRef     String?
  verifyToken     String?      @unique
  helpfulCount    Int          @default(0)
  status          ReviewStatus @default(PENDING_EMAIL)
  adminComment    String?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  event            Event?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  venue            Venue?                  @relation(fields: [venueId], references: [id], onDelete: SetNull)
  supplier         Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  siteUser         SiteUser?               @relation(fields: [siteUserId], references: [id], onDelete: SetNull)
  checkoutOrder    CheckoutOrder?          @relation(fields: [checkoutOrderId], references: [id], onDelete: SetNull)
  externalOrder    ExternalOrder?          @relation(fields: [externalOrderId], references: [id], onDelete: SetNull)
  supplierResponse ReviewSupplierResponse?
  disputes         ReviewDispute[]
  actionLogs       ReviewActionLog[]

  @@index([eventId, status])
  @@index([venueId, status])
  @@index([supplierId, status])
  @@index([siteUserId])
  @@index([checkoutOrderId])
  @@index([externalOrderId])
  @@index([status])
  @@index([createdAt])
}

model ReviewSupplierResponse {
  id                String                       @id @default(cuid())
  reviewId          String                       @unique
  supplierId        String
  text              String
  status            ReviewSupplierResponseStatus @default(DRAFT)
  moderationComment String?
  moderatedByUserId String?
  moderatedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, status])
  @@index([status])
}

model ReviewDispute {
  id                     String                  @id @default(cuid())
  reviewId               String
  supplierId             String
  status                 ReviewDisputeStatus     @default(MODERATOR_REVIEW)
  reasonCode             ReviewDisputeReasonCode
  claimText              String
  supplierConfirmedTruth Boolean                 @default(false)
  decisionComment        String?
  handledByUserId        String?
  resolvedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  review     Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  supplier   Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  actionLogs ReviewActionLog[]

  @@unique([reviewId])
  @@index([supplierId, status])
  @@index([status])
  @@index([createdAt])
}

model ReviewActionLog {
  id         String   @id @default(cuid())
  reviewId   String?
  disputeId  String?
  actorType  String
  actorId    String?
  actionType String
  payload    Json?
  createdAt  DateTime @default(now())

  review  Review?        @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  dispute ReviewDispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
  @@index([disputeId, createdAt])
  @@index([actionType])
}

model ExternalReview {
  id          String    @id @default(cuid())
  eventId     String?
  venueId     String?
  supplierId  String?
  source      String
  sourceUrl   String?
  authorName  String
  rating      Int
  text        String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  event    Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  venue    Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([eventId, source])
  @@index([venueId, source])
  @@index([supplierId])
}

model ReviewRequest {
  id              String    @id @default(cuid())
  email           String
  eventId         String
  checkoutOrderId String?
  externalOrderId String?
  token           String    @unique
  /// Snapshot for prefilled write form (date / event title / short order ref).
  purchaseDate    DateTime?
  purchaseRef     String?
  buyerName       String?
  sentAt          DateTime  @default(now())
  reminderSentAt  DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  reviewId        String?

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkoutOrder CheckoutOrder? @relation(fields: [checkoutOrderId], references: [id], onDelete: SetNull)
  externalOrder ExternalOrder? @relation(fields: [externalOrderId], references: [id], onDelete: SetNull)

  @@unique([email, eventId])
  @@index([token])
  @@index([eventId])
  @@index([checkoutOrderId])
  @@index([externalOrderId])
}

model QualityIssue {
  id         String    @id @default(cuid())
  eventId    String
  code       String
  severity   String
  message    String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  event Event @relation(fields: [eventId], references: [id])
}
