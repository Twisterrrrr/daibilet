{
  "name": "@daibilet/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Out-of-process sync job entrypoints (TC/TEP catalog + orders). Thin wrapper over root scripts/*.",
  "bin": {
    "daibilet-worker": "./bin/run.mjs"
  },
  "scripts": {
    "start": "node ./bin/run.mjs",
    "health": "node ./bin/run.mjs health",
    "tc-catalog": "node ./bin/run.mjs tc-catalog",
    "tep-catalog": "node ./bin/run.mjs tep-catalog",
    "tc-orders": "node ./bin/run.mjs tc-orders",
    "tep-orders": "node ./bin/run.mjs tep-orders"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
