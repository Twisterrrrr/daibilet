{
  "name": "@daibilet/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./public-read": {
      "types": "./src/public-read.ts",
      "default": "./src/public-read.ts"
    }
  },
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "start:ts": "tsx src/server-entry.ts",
    "dev:ts": "tsx src/server-entry.ts",
    "typecheck": "tsc --noEmit",
    "test:ts": "tsx --test src/landing-rules.test.ts src/public-catalog.mapper.test.ts src/public-warmup.test.ts",
    "catalog:parity": "tsx scripts/public-catalog-parity.ts",
    "event:parity": "tsx scripts/public-event-parity.ts",
    "city:parity": "tsx scripts/public-city-parity.ts",
    "venue:parity": "tsx scripts/public-venue-parity.ts",
    "admin-events:parity": "tsx scripts/admin-events-parity.ts",
    "admin-orders:parity": "tsx scripts/admin-orders-parity.ts",
    "tep:fixture-bridge": "node ../../scripts/teplohod-fixture-bridge.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@daibilet/contracts": "workspace:*",
    "@daibilet/db": "workspace:*",
    "pg": "^8.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
